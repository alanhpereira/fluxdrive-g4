          <q1:parameter uniqueID="UID_SUB_402202" access="readWrite">
            <description lang="en">[V] trip after 1 ms above it: zero-current coast (no regen, no braking), resumes once the bus is below vmax - vresume; outside a run STOP resets. 0 = off</description>
            <REAL />
            <q1:defaultValue value="0.0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="100" />
