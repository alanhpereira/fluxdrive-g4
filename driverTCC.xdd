          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_402203" access="readWrite">
            <description lang="en">[°C] board NTC: the current cap falls from imax to zero over the 10 °C below it, the run stops at it and starts again 10 °C below it. 0 = off (the MCU die limit of 110 °C stays)</description>
            <REAL />
            <q1:defaultValue value="0.0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="150" />
