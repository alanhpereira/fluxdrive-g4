            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_402204" access="readWrite">
            <description lang="en">[V] braking current falls linearly to zero from vmax - vclamp to vmax, so decelerations stay within what the bus can take; motoring is never limited. 0 = off</description>
            <REAL />
            <q1:defaultValue value="0.0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="20" />
